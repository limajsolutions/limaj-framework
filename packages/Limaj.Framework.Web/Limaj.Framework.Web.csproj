<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Remove="Limaj.Framework.Web.Tests\**\*.cs" />
    <None Remove="Limaj.Framework.Web.Tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Limaj.Framework.Abstractions\Limaj.Framework.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Limaj.Framework.Web.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Limaj.Framework.Web</PackageId>
    <Description>ASP.NET Core HTTP adapters for Limaj Framework: maps Result/ErrorType to HTTP status codes and converts domain exceptions to structured responses via RequestRunner.</Description>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
</Project>
