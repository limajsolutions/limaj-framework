<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Remove="Limaj.Framework.Abstractions.Tests\**\*.cs" />
    <None Remove="Limaj.Framework.Abstractions.Tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Limaj.Framework.Abstractions</PackageId>
    <Description>Pure contracts and types for Limaj Framework: Result/Error flow, BaseEntity with soft delete, domain exceptions, repository/unit-of-work and identity gateway abstractions. No dependencies.</Description>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
</Project>
