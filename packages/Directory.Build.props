<Project>
  <!--
    Package metadata shared by the 4 Limaj.Framework.* packages (each .csproj sets its own
    Description). Test projects also import this file but stay IsPackable=false.
    Published to nuget.org (stable tags) and GitHub Packages (pre-releases) by
    .github/workflows/publish-packages.yml.
  -->
  <PropertyGroup>
    <Authors>Limaj Solutions</Authors>
    <Company>Limaj Solutions</Company>
    <Copyright>Copyright (c) Limaj Solutions</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/limajsolutions/limaj-framework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/limajsolutions/limaj-framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>limaj;framework;clean-architecture;result;efcore;aspnetcore;azure-functions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols (.snupkg) go to nuget.org's symbol server; GitHub Packages doesn't support them. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)PACKAGE_README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>
